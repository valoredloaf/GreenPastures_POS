{
  "expo": {
    "name": "Green Pastures POS",
    "slug": "CoffeeOrderingApp2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.valoredloaf.greenpasturespos",
    "adaptiveIcon": {
      "backgroundColor": "#FFFFFF",
      "foregroundImage": "./assets/android-icon-foreground.png"
    },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Green Pastures POS to use the camera to capture G-Cash payment proof."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9317d77-1015-4757-9ae4-0cdde831db68"
      }
    },
    "owner": "loafthegret"
  }
}
